{
  "name": "vehicle-poster",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/server.ts",
    "build": "tsc -b && vite build",
    "test:queue": "node --import=./tests/helpers/offline.mjs tests/queue-flow.mjs",
    "test:stock": "node --import=./tests/helpers/offline.mjs tests/stock-state.mjs",
    "test:autonomous": "node --import=./tests/helpers/offline.mjs tests/autonomous-flow.mjs",
    "test:extension-consumer": "node --import=./tests/helpers/offline.mjs tests/extension-consumer.mjs",
    "test:publish-safety": "node --import=./tests/helpers/offline.mjs tests/publish-safety.mjs",
    "test:extension-session": "node --import=./tests/helpers/offline.mjs tests/extension-session-renewal.mjs",
    "test:intelligence": "node --import=./tests/helpers/offline.mjs tests/phase-five-intelligence.mjs",
    "test:design": "node tests/phase-six-design.mjs",
    "test:observability": "node --import=./tests/helpers/offline.mjs tests/phase-four-observability.mjs",
    "test:orchestration": "node --import=./tests/helpers/offline.mjs tests/phase-three-orchestration.mjs",
    "test:phase-one": "node --import=./tests/helpers/offline.mjs tests/phase-one-integrity.mjs",
    "test:backup": "node --import=./tests/helpers/offline.mjs tests/backup.mjs",
    "backup": "node scripts/backup.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:audit": "node --import=./tests/helpers/offline.mjs tests/audit-services.mjs",
    "test:fipe": "node --import=./tests/helpers/offline.mjs tests/fipe-service.mjs",
    "test:timezone": "node --import=./tests/helpers/offline.mjs tests/scheduler-timezone.mjs",
    "test:sessions": "node --import=./tests/helpers/offline.mjs tests/session-expiry.mjs",
    "test:extension-resilience": "node --import=./tests/helpers/offline.mjs tests/extension-resilience.mjs",
    "test:operations": "node --import=./tests/helpers/offline.mjs tests/operations.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:selector-config": "node tests/selector-config.mjs",
    "test:vehicle-import": "node tests/vehicle-import.mjs",
    "test:selector-health": "node tests/selector-health.mjs",
    "test:google-auth": "node --import=./tests/helpers/offline.mjs tests/google-auth.mjs",
    "test:login-diagnostics": "node --import=./tests/helpers/offline.mjs tests/login-diagnostics.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test:operational-ui": "node tests/phase-six-operational-ui.mjs",
    "test": "npm run test:ai-approval && npm run test:queue && npm run test:stock && npm run test:autonomous && npm run test:extension-consumer && npm run test:publish-safety && npm run test:extension-session && npm run test:intelligence && npm run test:design && npm run test:observability && npm run test:orchestration && npm run test:phase-one && npm run test:backup && npm run test:audit && npm run test:fipe && npm run test:timezone && npm run test:sessions && npm run test:extension-resilience && npm run test:operations && npm run test:selector-config && npm run test:vehicle-import && npm run test:selector-health && npm run test:google-auth && npm run test:login-diagnostics && npm run test:operational-ui && npm run test:management-ui && npm run test:design-final && npm run test:vehicle-zip && npm run test:group-integrity",
    "test:management-ui": "node tests/phase-six-management-ui.mjs",
    "test:design-final": "node tests/phase-six-final-polish.mjs",
    "test:vehicle-zip": "node tests/vehicle-zip-import.mjs",
    "test:group-integrity": "node --import=./tests/helpers/offline.mjs tests/group-curation-integrity.mjs",
    "test:ai-approval": "node --import=./tests/helpers/offline.mjs tests/ai-approval-safety.mjs"
  },
  "dependencies": {
    "google-auth-library": "^11.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1"
  },
  "license": "MIT",
  "overrides": {
    "concurrently": {
      "shell-quote": "^1.11.0"
    }
  }
}
