{
  "manifest_version": 3,
  "name": "AutoFlow para Brave",
  "version": "0.13.0",
  "description": "Preenchimento assistido de veículos a partir da fila local do AutoFlow.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:3333/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_title": "AutoFlow",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
