# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
# Mínimo de 12 caracteres; preencha antes do primeiro boot.
INITIAL_ADMIN_PASSWORD=
INITIAL_ORGANIZATION_NAME=AutoFlow
# Opcional: OAuth Client ID do tipo Aplicativo da Web (Google Auth Platform).
# A primeira conexão exige o mesmo e-mail cadastrado e a senha atual do AutoFlow.
GOOGLE_CLIENT_ID=
PORT=3333
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_ORIGIN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# O painel usa /api por padrão. Para API em outra origem, defina antes do build:
# VITE_API_URL=https://api.seudominio.com/api
SCHEDULE_TIMEZONE=America/Sao_Paulo
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=900
LOG_LEVEL=info
GEMINI_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
