# Chave de segurança para tokens de autenticação (mínimo de 32 caracteres)
AUTH_SECRET=autoflow-super-secret-key-at-least-32-chars-long

# Credenciais do administrador inicial (criado no primeiro boot se o banco estiver vazio)
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@autoflow.local
INITIAL_ADMIN_PASSWORD=admin12345678
INITIAL_ORGANIZATION_NAME=AutoPrime Veículos

# Servidor de API
PORT=3333
HOST=127.0.0.1

# Inteligência Artificial (Opcional - também pode ser configurado diretamente no painel web em Configurações)
# Obtenha gratuitamente em https://aistudio.google.com/
GEMINI_API_KEY=
# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=
