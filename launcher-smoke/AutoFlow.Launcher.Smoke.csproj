<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>AutoFlowLauncher.LauncherNetworkSmoke</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../launcher/Program.cs" Link="Program.cs" />
    <Compile Include="../launcher/AutoFlowProcessManager.cs" Link="AutoFlowProcessManager.cs" />
    <Compile Include="../launcher/LauncherInstanceGuard.cs" Link="LauncherInstanceGuard.cs" />
    <Compile Include="../launcher/LauncherLog.cs" Link="LauncherLog.cs" />
    <Compile Include="LauncherNetworkSmoke.cs" />
  </ItemGroup>
</Project>
